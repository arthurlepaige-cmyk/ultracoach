# Copie ce fichier en .env et remplis les valeurs

# IA — Groq (gratuit) : https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel — modèle Groq (défaut: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Sécurité — change cette valeur en production !
JWT_SECRET=change_this_secret_in_production

# Optionnel — Anthropic (fallback si pas de Groq)
# ANTHROPIC_API_KEY=sk-ant-xxxx
